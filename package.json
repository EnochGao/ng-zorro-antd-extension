{
  "name": "ng-zorro-antd-extension",
  "version": "21.0.0",
  "license": "MIT",
  "description": "An extension based on ng-zorro-antd",
  "keywords": [
    "angular",
    "ng-zorro-antd",
    "frontend",
    "extension",
    "ng-zorro-antd-extension"
  ],
  "homepage": "https://ng-zorro-antd-extension.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnochGao/ng-zorro-antd-extension.git"
  },
  "author": {
    "name": "enochgao",
    "email": "enochgao@qq.com"
  },
  "scripts": {
    "ng": "npx ng",
    "start": "npx ng serve ui",
    "build": "npx ng build ui --configuration production",
    "build:lib": "npx ng build ng-zorro-antd-extension",
    "build:components": "cd components && npm run build && npm run postbuild",
    "build:all": "npm-run-all \"build:lib\" \"build:components\" \"deploy\"",
    "deploy": "cd dist/ng-zorro-antd-extension && npm publish",
    "watch": "npx ng build --watch --configuration development",
    "ui": "npx ng serve ui",
    "test": "npx ng test",
    "prepare": "husky install"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@commitlint/format": "^19.3.0",
    "@ctrl/tinycolor": "^4.2.0",
    "@vivliostyle/core": "^2.29.0",
    "@wangeditor-next/editor": "^5.6.49",
    "@wangeditor/editor": "^5.1.23",
    "conventional-changelog-atom": "^5.0.0",
    "date-fns": "^2.29.2",
    "ng-zorro-antd": "^22.0.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.1.3",
    "@angular-devkit/schematics": "^22.1.3",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@stackblitz/sdk": "^1.11.1",
    "@types/jasmine": "~4.0.0",
    "@types/prismjs": "^1.26.6",
    "copyfiles": "^2.4.1",
    "husky": "^9.0.11",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "less": "^4.2.0",
    "marked": "^18.0.0",
    "marked-highlight": "^2.2.2",
    "ng-packagr": "^22.1.1",
    "npm-run-all": "^4.1.5",
    "prismjs": "^1.30.0",
    "slugify": "^1.6.9",
    "typescript": "~6.0.3"
  }
}
